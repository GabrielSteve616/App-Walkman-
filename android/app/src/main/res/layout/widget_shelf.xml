<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="@drawable/walkmen_panel" android:padding="8dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="32dp" android:gravity="center_vertical">
        <TextView android:id="@+id/shelf_previous" android:layout_width="36dp" android:layout_height="32dp" android:gravity="center" android:text="‹" android:textSize="26sp" android:textColor="#FFFFFF" android:contentDescription="Fitas anteriores" />
        <TextView android:id="@+id/shelf_title" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="MINHAS FITAS" android:gravity="center" android:textColor="#EEDABC" android:textSize="12sp" android:textStyle="bold" />
        <TextView android:id="@+id/shelf_next" android:layout_width="36dp" android:layout_height="32dp" android:gravity="center" android:text="›" android:textSize="26sp" android:textColor="#FFFFFF" android:contentDescription="Próximas fitas" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal" android:gravity="center">
        <LinearLayout android:id="@+id/shelf_left" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:orientation="vertical" android:gravity="center" android:padding="3dp">
            <ImageView android:id="@+id/shelf_left_art" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:scaleType="fitCenter" android:contentDescription="Primeira fita" />
            <TextView android:id="@+id/shelf_left_name" android:layout_width="match_parent" android:layout_height="30dp" android:gravity="center" android:textColor="#F3E8D4" android:textSize="12sp" android:maxLines="1" android:ellipsize="end" />
        </LinearLayout>
        <LinearLayout android:id="@+id/shelf_right" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:orientation="vertical" android:gravity="center" android:padding="3dp">
            <ImageView android:id="@+id/shelf_right_art" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:scaleType="fitCenter" android:contentDescription="Segunda fita" />
            <TextView android:id="@+id/shelf_right_name" android:layout_width="match_parent" android:layout_height="30dp" android:gravity="center" android:textColor="#F3E8D4" android:textSize="12sp" android:maxLines="1" android:ellipsize="end" />
        </LinearLayout>
    </LinearLayout>
    <TextView android:layout_width="match_parent" android:layout_height="6dp" android:background="#8B6844" android:text="" />
</LinearLayout>
