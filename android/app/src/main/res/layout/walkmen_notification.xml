<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="180dp" android:background="@drawable/walkmen_panel" android:padding="10dp">
    <ImageView android:id="@+id/notif_tape" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitXY" android:alpha="0.50" android:contentDescription="Fita cassete" />
    <ImageView android:id="@+id/notif_art" android:layout_width="48dp" android:layout_height="48dp" android:scaleType="centerCrop" android:contentDescription="Capa da música" />
    <TextView android:id="@+id/notif_title" android:layout_width="match_parent" android:layout_height="24dp" android:layout_toEndOf="@id/notif_art" android:layout_marginStart="10dp" android:textColor="#FFFFFF" android:textSize="15sp" android:textStyle="bold" android:maxLines="1" android:ellipsize="end" />
    <TextView android:id="@+id/notif_artist" android:layout_width="match_parent" android:layout_height="24dp" android:layout_below="@id/notif_title" android:layout_toEndOf="@id/notif_art" android:layout_marginStart="10dp" android:textColor="#DDD6C9" android:textSize="12sp" android:maxLines="1" android:ellipsize="end" />
    <LinearLayout android:id="@+id/notif_controls" android:layout_width="match_parent" android:layout_height="54dp" android:layout_alignParentBottom="true" android:gravity="center" android:orientation="horizontal">
        <ImageButton android:id="@+id/notif_previous" android:layout_width="54dp" android:layout_height="48dp" android:padding="12dp" android:src="@drawable/audio_service_skip_previous" android:background="@android:color/transparent" android:contentDescription="Anterior" />
        <ImageButton android:id="@+id/notif_play" android:layout_width="64dp" android:layout_height="52dp" android:padding="10dp" android:src="@drawable/audio_service_play_arrow" android:background="@android:color/transparent" android:contentDescription="Reproduzir ou pausar" />
        <ImageButton android:id="@+id/notif_next" android:layout_width="54dp" android:layout_height="48dp" android:padding="12dp" android:src="@drawable/audio_service_skip_next" android:background="@android:color/transparent" android:contentDescription="Próxima" />
    </LinearLayout>
    <TextView android:id="@+id/notif_time" android:layout_width="match_parent" android:layout_height="20dp" android:layout_above="@id/notif_controls" android:textColor="#EDE6D8" android:textSize="11sp" />
    <ProgressBar android:id="@+id/notif_progress" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="6dp" android:layout_above="@id/notif_time" android:progressTint="#EEA450" android:progressBackgroundTint="#66717C" />
</RelativeLayout>
